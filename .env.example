# Copy to .env or .env.local. Firebase Console > Project settings > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase AI Logic model
VITE_GEMINI_MODEL=gemini-3.8-flash

# Sarvam Bulbul text-to-speech (required for spoken audio)
# IMPORTANT: VITE_ variables are included in browser code. A production-safe setup needs a server-side proxy.
VITE_SARVAM_API_KEY=
VITE_SARVAM_TTS_MODEL=bulbul:v3
VITE_SARVAM_BN_SPEAKER=roopa
VITE_SARVAM_EN_SPEAKER=ishita

# Production Firebase App Check (reCAPTCHA v3 site key)
VITE_RECAPTCHA_V3_SITE_KEY=6LfFORMuAAAAAD05SqFnmSM3_EMEFwfZN415hIHA
